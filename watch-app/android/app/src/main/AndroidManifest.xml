<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Watch device feature -->
    <uses-feature android:name="android.hardware.type.watch" />

    <!-- BLE Peripheral (GATT Server + Advertiser) -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />
    <!-- Legacy Bluetooth (targetSdk<=30 runtime) -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- BLE advertise on API 23-30 requires location -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <!-- Android 12+ Bluetooth runtime permissions -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Foreground service for the BLE link -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Vibration -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Sensors (accelerometer for gesture detection) -->
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ClawdWatch"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="30">


        <!-- Main activity: pet + agent status -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pairing activity: BLE advertise + wait for Central -->
        <activity
            android:name=".PairingActivity"
            android:exported="true"
            android:theme="@style/Theme.ClawdWatch" />

        <!-- Approval activity: permission request UI -->
        <activity
            android:name=".ApprovalActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.ClawdWatch" />

        <!-- BLE foreground service -->
        <service
            android:name=".service.BleService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

    </application>
</manifest>
