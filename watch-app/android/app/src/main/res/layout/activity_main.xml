<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <com.clawd.watch.renderer.PetView
        android:id="@+id/pet_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- High-risk border pulse overlay -->
    <View
        android:id="@+id/high_risk_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/border_pulse_red"
        android:visibility="gone" />

    <!-- Connection indicator pill (top center) -->
    <TextView
        android:id="@+id/connection_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="6dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:background="@drawable/pill_indicator"
        android:text="⬤"
        android:textSize="9sp"
        android:textColor="#CCFFFFFF"
        android:gravity="center" />

    <!-- Battery warning (top-end) -->
    <TextView
        android:id="@+id/battery_warning"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="8dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:background="@drawable/pill_indicator"
        android:text="🪫"
        android:textSize="9sp"
        android:visibility="gone" />

    <!-- Gesture feedback overlay (center) -->
    <TextView
        android:id="@+id/gesture_feedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textSize="48sp"
        android:visibility="gone" />

    <!-- Reconnect affordance (center) -->
    <TextView
        android:id="@+id/reconnect_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="@drawable/pill_indicator"
        android:text="↻ Tap to reconnect"
        android:textSize="11sp"
        android:textColor="#CCFFFFFF"
        android:gravity="center"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true" />

    <!-- High-risk tap hint -->
    <TextView
        android:id="@+id/high_risk_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="28dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:background="@drawable/pill_indicator"
        android:text="Tap to review"
        android:textSize="10sp"
        android:textColor="#FFF44336"
        android:gravity="center"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true" />

    <!-- State chip pill (bottom center) -->
    <TextView
        android:id="@+id/state_chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="10dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:background="@drawable/pill_chip"
        android:textSize="10sp"
        android:textColor="#E6FFFFFF"
        android:gravity="center"
        android:visibility="gone" />

</FrameLayout>
