<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="28dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Settings"
            android:textSize="14sp"
            android:textColor="#FFFFFFFF" />

        <!-- Vibration Strength -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Vibration"
            android:textSize="10sp"
            android:textColor="#99FFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/vib_strong"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:text="Strong"
                android:textSize="9sp"
                android:textColor="#FFFFFFFF"
                android:background="@drawable/pill_chip" />

            <Button
                android:id="@+id/vib_normal"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:text="Normal"
                android:textSize="9sp"
                android:textColor="#FFFFFFFF"
                android:background="@drawable/pill_chip" />

            <Button
                android:id="@+id/vib_off"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:text="Off"
                android:textSize="9sp"
                android:textColor="#FFFFFFFF"
                android:background="@drawable/pill_chip" />
        </LinearLayout>

        <!-- Gesture Sensitivity -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Gesture Sensitivity"
            android:textSize="10sp"
            android:textColor="#99FFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/sens_high"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:text="High"
                android:textSize="9sp"
                android:textColor="#FFFFFFFF"
                android:background="@drawable/pill_chip" />

            <Button
                android:id="@+id/sens_standard"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:text="Standard"
                android:textSize="9sp"
                android:textColor="#FFFFFFFF"
                android:background="@drawable/pill_chip" />

            <Button
                android:id="@+id/sens_low"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:text="Low"
                android:textSize="9sp"
                android:textColor="#FFFFFFFF"
                android:background="@drawable/pill_chip" />
        </LinearLayout>

        <!-- Keep Screen On -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Keep screen on"
                android:textSize="11sp"
                android:textColor="#CCFFFFFF" />

            <CheckBox
                android:id="@+id/keep_screen_on"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
